{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Sprint 2 Admin Catalog API Engine",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/app.js",
    "dev": "node --watch --env-file=.env src/app.js",
